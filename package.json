{
  "name": "website-bot",
  "version": "3.1.0",
  "description": "L9 Website Factory: DomainSpec to proven Astro source, client GitHub commit, Vercel deployment, and release receipt",
  "type": "module",
  "scripts": {
    "pipeline": "npx tsx scripts/run-pipeline.ts",
    "pipeline:plan": "npx tsx scripts/run-pipeline.ts --mode=plan --spec=fixtures/ci-test-spec.yaml",
    "pipeline:dry": "npm run pipeline:plan",
    "pipeline:local-proof": "npx tsx scripts/run-pipeline.ts --mode=local-proof",
    "pipeline:publish-proof": "npx tsx scripts/run-pipeline.ts --mode=publish-proof",
    "pipeline:end-to-end": "npx tsx scripts/run-pipeline.ts --mode=end-to-end",
    "interop:build": "npm --prefix packages/bot-interop run build",
    "interop:test": "npm --prefix packages/bot-interop run verify:all",
    "pretypecheck": "npm run interop:build",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: no standalone ESLint configured; type safety is enforced by tsc --noEmit (npm run typecheck)'",
    "generate-spec": "npx tsx scripts/generate-spec.ts",
    "normalize-spec": "npx tsx scripts/normalize-spec.ts",
    "normalize-spec:check": "npx tsx scripts/normalize-spec.ts --check",
    "validate": "node scripts/verify-launch-env.mjs",
    "site:validate": "npx tsx scripts/validate-site-factory.ts --spec=fixtures/ci-test-spec.yaml",
    "site:validate:build": "npx tsx scripts/validate-site-factory.ts --spec=fixtures/ci-test-spec.yaml --build",
    "site:test": "node scripts/run-site-factory-tests.mjs --scope=all",
    "site:test:local": "node scripts/run-site-factory-tests.mjs --scope=local",
    "site:test:github": "node scripts/run-site-factory-tests.mjs --scope=github",
    "site:test:vercel": "node scripts/run-site-factory-tests.mjs --scope=vercel",
    "site:test:e2e": "node scripts/run-site-factory-tests.mjs --scope=e2e",
    "site:disposable-e2e": "npx tsx scripts/run-disposable-site-factory-e2e.ts",
    "verify:all": "npm run interop:test && npm run typecheck && npm run normalize-spec:check && npm run evidence:schemas && npm run evidence:contract-parity && npm run interop:parity && npm run blueprint:v1-eradication && npm run site:validate && npm run evidence:test && npm run site:test:local && npm run provision:test && npm run pipeline:plan && npm run alignment:boundaries && npm run llm:wiring && npm run recursive:schemas && npm run recursive:test",
    "provision:plan": "npx tsx scripts/provision-client.ts --plan",
    "provision:client": "npx tsx scripts/provision-client.ts",
    "provision:test": "npm run typecheck:provisioning && node scripts/run-site-factory-tests.mjs --scope=provisioning",
    "typecheck:provisioning": "tsc -p tsconfig.provisioning.json --noEmit",
    "evidence:schemas": "node scripts/validate-evidence-schemas.mjs",
    "evidence:contract-parity": "node scripts/validate-contract-lock.mjs",
    "evidence:test": "node scripts/run-site-factory-tests.mjs --scope=evidence",
    "evidence:show": "npx tsx scripts/evidence.ts show",
    "evidence:validate": "npx tsx scripts/evidence.ts validate",
    "evidence:resume": "npx tsx scripts/evidence.ts resume",
    "evidence:repair-index": "npx tsx scripts/evidence.ts repair-index",
    "evidence:verify-external": "npx tsx scripts/evidence.ts verify-external",
    "alignment:boundaries": "node scripts/validate-l9-boundaries.mjs",
    "llm:wiring": "node scripts/validate-llm-wiring.mjs",
    "spec-path:validate": "node scripts/validate-spec-path.mjs",
    "verify:preflight": "npx tsx scripts/validation-executor.ts run --profile preflight",
    "verify:source": "npx tsx scripts/validation-executor.ts run --profile source",
    "verify:build": "npx tsx scripts/validation-executor.ts run --profile build",
    "verify:smoke": "npx tsx scripts/validation-executor.ts run --profile smoke",
    "verify:form": "npx tsx scripts/validation-executor.ts run --profile form",
    "verify:analytics": "npx tsx scripts/validation-executor.ts run --profile analytics",
    "verify:crm": "npx tsx scripts/validation-executor.ts run --profile crm",
    "verify:seo": "npx tsx scripts/validation-executor.ts run --profile seo",
    "verify:rollback": "npx tsx scripts/validation-executor.ts run --profile rollback",
    "verify:launch-env": "node scripts/verify-launch-env.mjs --client-launch",
    "verify:deploy-secrets": "node scripts/verify-deploy-secrets.mjs",
    "verify:visual-qa": "node scripts/verify-visual-qa.mjs",
    "campaign": "npx tsx scripts/campaign.ts",
    "campaign:status": "npx tsx scripts/campaign-status.ts",
    "campaign:review": "npx tsx scripts/campaign-review.ts",
    "recursive:improve": "npx tsx scripts/recursive/recursive-cli.ts improve",
    "recursive:status": "npx tsx scripts/recursive/recursive-cli.ts status",
    "recursive:resume": "npx tsx scripts/recursive/recursive-cli.ts resume",
    "recursive:simulate": "npx tsx scripts/recursive/recursive-cli.ts simulate",
    "recursive:schemas": "node scripts/validate-recursive-schemas.mjs",
    "recursive:test": "node scripts/run-recursive-tests.mjs",
    "golden:safehaven:visual": "npx tsx scripts/run-safehaven-golden-visual.ts",
    "golden:safehaven:receipt": "npx tsx scripts/build-safehaven-real-golden-receipt.ts",
    "golden:safehaven:verify": "npx tsx scripts/run-safehaven-real-golden-verify.ts",
    "golden:safehaven:bridge:test": "node --import tsx --test tests/unit/safehaven-real-golden-bridge.test.ts",
    "interop:parity": "node scripts/validate-interop-parity.mjs",
    "blueprint:v1-eradication": "node scripts/validate-blueprint-v1-eradication.mjs"
  },
  "dependencies": {
    "@quantum-l9/bot-interop": "file:packages/bot-interop",
    "@quantum-l9/graphiti-memory-client": "file:packages/graphiti-memory-client",
    "@quantum-l9/infisical-config": "file:packages/infisical-config",
    "@quantum-l9/llm-router": "file:packages/llm-router",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "inngest": "^4.19.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "undici": "^8.10.0",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.21.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "@quantum-l9/graphiti-memory-client": "file:packages/graphiti-memory-client",
    "@quantum-l9/infisical-config": "file:packages/infisical-config"
  }
}
